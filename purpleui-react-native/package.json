{
  "name": "purpleui-react-native",
  "version": "0.1.0",
  "private": true,
  "description": "Purple UI design system for React Native - tokens + components, matching PurpleUI-iOS and PurpleUI-Android.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "devDependencies": {
    "@types/react": "^18",
    "react": "^18",
    "react-native": "^0.74",
    "typescript": "^5"
  }
}
