{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    // The native packages each own their own toolchain and tsconfig, and their
    // dependencies are not installed at this root (no npm workspaces here).
    // Without these exclusions `next build` type-checks purpleui-react-native/
    // against the web app's config, fails to resolve `react-native`, and breaks
    // the docs-site deploy - even though nothing in src/ imports it.
    // Verify React Native separately: cd purpleui-react-native && npm run build
    "purpleui-react-native",
    "PurpleUI-iOS",
    "PurpleUI-Android"
  ]
}
